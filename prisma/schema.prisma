// HeartWhisper Prisma schema
// Docs: https://pris.ly/d/prisma-schema
//
// Local demo uses SQLite (see DATABASE_URL in .env.example).
// The main UI is still mostly client-side simulation; these models are
// scaffolding for future accounts / journal features.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// App user (future auth / pairing identity).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

/// Lightweight content / journal entry owned by a user.
model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}
