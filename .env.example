# HeartWhisper / Heart-Wispher local environment
# Copy to .env and adjust values before running Prisma or the app.

# SQLite database used by Prisma (relative path is fine for local dev)
DATABASE_URL="file:./db/custom.db"

# Optional: Node environment (development | production | test)
# NODE_ENV=development

# Optional: NextAuth (not wired in the demo UI yet; reserved for future auth)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace-with-a-long-random-string
